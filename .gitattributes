# Chuẩn hoá line ending: Linux VM cần LF cho shell script
* text=auto

*.sh   text eol=lf
*.py   text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.cfg  text eol=lf
*.gam  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf

# Windows-only
*.ps1  text eol=crlf
*.bat  text eol=crlf

# Binary
*.wasm binary
*.pk3  binary
*.zip  binary
*.tar.xz binary
*.png  binary
*.svg  text
*.ico  binary
