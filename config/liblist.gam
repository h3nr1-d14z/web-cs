// Counter-Strike 1.6 game definition.
// Shipped so the server never depends on how a particular HLDS build formatted
// its copy; Xash3D needs gamedll_linux to find the ReGameDLL module.
game "Counter-Strike"
url_info "www.counter-strike.net"
url_dl ""
version "1.6"
size "184000000"
svonly "0"
secure "0"
type "multiplayer_only"
cldll "1"
hlversion "1111"
nomodels "1"
nohimodel "1"
mpentity "info_player_start"
gamedll "dlls\mp.dll"
gamedll_linux "dlls/cs.so"
trainmap "tr_1"
