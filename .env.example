# Copy sang .env rồi sửa. `docker compose` tự đọc file này.

# Cổng trên máy host để coworker mở http://<ip>:27016
WEB_PORT=27016

# Mật khẩu rcon của game server (khớp config/server.cfg). Tab Server trên web
# và các endpoint /api/admin dùng nó để gửi lệnh (đổi map, preset...).
RCON_PASSWORD=doi-mat-khau-nay

# Để trống = ai vào được IP là chơi được (dựa vào NetBird làm hàng rào).
# Đặt một chuỗi bất kỳ để bắt buộc nhập mã ở màn hình dashboard.
ACCESS_CODE=

# Phòng trống quá bao lâu (giây) thì tự đóng. Mặc định 1800 = 30 phút.
EMPTY_TTL=1800

# Chế độ parkour KZ (metamod + AMXX + ProKreedz): checkpoint/timer, KHÔNG bots.
# 0 = mặc định (YaPB bots). Bật: KZ_MODE=1
KZ_MODE=0
